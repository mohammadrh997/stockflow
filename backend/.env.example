DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/stockflow
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/stockflow_test
# at least 32 characters; generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
LOG_LEVEL=INFO
# how long an access token lasts, and how long a login survives unused
# ACCESS_TOKEN_EXP_MINUTES=15
# REFRESH_TOKEN_EXP_DAYS=7
# behind Render (Cloudflare) set to cf-connecting-ip; leave unset locally
# CLIENT_IP_HEADER=
# product images: any S3-compatible bucket; leave unset to turn uploads off (503)
# STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# STORAGE_REGION=us-east-005
# STORAGE_BUCKET=
# STORAGE_KEY_ID=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_URL=
